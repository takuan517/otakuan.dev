# Build-time settings: enable only after server secrets and delivery are verified.
PUBLIC_CONTACT_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=
# Configure these in Cloudflare Pages Functions, never with PUBLIC_ prefixes:
# TURNSTILE_SECRET_KEY
# RESEND_API_KEY
# CONTACT_FROM (verified Resend sender, e.g. Website <form@notify.otakuan.dev>)
# CONTACT_ORIGIN=https://otakuan.dev
