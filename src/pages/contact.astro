---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactForm from '../components/ContactForm.astro';
import { ja, site } from '../data/site';
---
<Layout title="Contact"><PageIntro label="Contact" title={ja.contact.title} description={ja.contact.intro} /><div class="shell contact-layout"><div><section><h2>{ja.contact.examplesTitle}</h2><ul class="plain-list">{ja.contact.examples.map((item) => <li>{item}</li>)}</ul></section><section class="elsewhere"><h2>{ja.contact.profiles}</h2>{site.profiles.length ? <ul class="plain-list">{site.profiles.map((profile) => <li><a href={profile.url}>{profile.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul> : <p>{ja.contact.profilesPending}</p>}</section></div><div><section class="contact-email" aria-labelledby="email-title"><h2 id="email-title">メールでのお問い合わせ</h2><p>お仕事のご相談は、こちらのメールアドレスへお送りください。</p><a class="text-link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a><p class="field-hint">リンクを押すとメールアプリが開きます。Webメールをご利用の場合は、アドレスをコピーして宛先に指定してください。</p></section><section><h2>{ja.contact.formTitle}</h2><ContactForm /></section></div></div></Layout>
