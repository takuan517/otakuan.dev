---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { ja, site, experience, technologies } from '../data/site';
---
<Layout title="About"><PageIntro label="About" title={ja.about.title} description={ja.about.intro} />
<section class="section shell reading-section"><h2>Profile</h2><div><p class="profile-name">{site.name}</p><p class="eyebrow">{site.role}</p>{ja.about.paragraphs.map((p) => <p>{p}</p>)}</div></section>
<section class="section shell reading-section"><h2>Experience</h2><div>{experience.length ? experience.map((item) => <article><p class="eyebrow">{item.period}</p><h3>{item.company}</h3><p>{item.role}</p><p>{item.description}</p></article>) : <p>{ja.about.experienceNote}</p>}<a class="text-link" href="/works/">View Works</a></div></section>
<section class="section shell reading-section"><h2>Technologies</h2><dl class="tech-groups">{technologies.map(({ category, items }) => <div><dt>{category}</dt><dd>{items.join(' / ')}</dd></div>)}</dl></section><ContactCTA /></Layout>
