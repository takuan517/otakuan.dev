---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { ja, site, experience, contractExperience, technologies } from '../data/site';
---
<Layout title="About"><PageIntro label="About" title={ja.about.title} description={ja.about.intro} />
<section class="section shell reading-section"><h2>Profile</h2><div><div class="profile-identity"><img class="profile-avatar" src="/avatar.png" alt="" width="512" height="512" /><div><p class="profile-name">{site.name}</p><p class="eyebrow">{site.role}</p></div></div>{ja.about.paragraphs.map((p) => <p>{p}</p>)}</div></section>
<section class="section shell reading-section experience-section">
  <h2>Experience</h2>
  <div>
    <h3>企業・組織での経歴</h3>
    <ul class="experience-list">{experience.map((item) => <li><p class:list={["experience-title", { "experience-title-normal": item.company === "W3C Japan / WCAP" }]}>{item.company}<span> / {item.role}</span></p>{item.description && <p>{item.description}</p>}</li>)}</ul>
    <h3>業務委託での主な参画</h3>
    <ul class="experience-list">{contractExperience.map((item) => <li><p class="experience-title">{item.title}</p><p>{item.description}</p></li>)}</ul>
    <a class="text-link" href="/works/">View Works</a>
  </div>
</section>
<section class="section shell reading-section"><h2>Technologies</h2><dl class="tech-groups">{technologies.map(({ category, items }) => <div><dt>{category}</dt><dd>{items.join(' / ')}</dd></div>)}</dl></section><ContactCTA /></Layout>
