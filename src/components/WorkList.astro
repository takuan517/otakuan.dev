---
import type { CollectionEntry } from 'astro:content';
import { ja } from '../data/site';
interface Props { works: CollectionEntry<'works'>[]; showImages?: boolean }
const { works, showImages = false } = Astro.props;
---
<div class="work-list">{works.map(({ data }) => <article class="work-item">
  {showImages && data.image && <img class="work-image" src={data.image.src} alt={data.image.alt} width={data.image.width} height={data.image.height} loading="lazy" />}
  <h3>{data.title}</h3>
  <p>{data.description}</p>
  {data.technologies.length > 0 && <p class="work-technologies">{data.technologies.join(' / ')}</p>}
  {(data.period || data.year) && <p class="work-period">{data.period ?? data.year}</p>}
  {data.url && <a class="text-link" href={data.url}>{data.linkLabel ?? ja.works.external}<span aria-hidden="true"> ↗</span></a>}
  {data.sample && <p class="work-status">{ja.works.sampleLabel}</p>}
</article>)}</div>
