---
<ul class:list={['social-links', { 'with-labels': labels }]}>
  {site.profiles.map((profile) => <li><a href={profile.url} aria-label={labels ? undefined : profile.label} title={profile.label}><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={paths[profile.icon]} /></svg>{labels && <span>{profile.label}</span>}</a></li>)}
</ul>
