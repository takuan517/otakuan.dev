---
import { ja, site } from '../data/site';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const enabled = import.meta.env.PUBLIC_CONTACT_ENABLED === 'true' && Boolean(siteKey);
const endpoint = '/api/contact';
const t = ja.contact;
---
{enabled && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<form action={enabled ? endpoint : undefined} method="post" aria-describedby={!enabled ? 'form-status' : undefined}>
  {!enabled && <p class="notice" id="form-status">{t.unavailable}</p>}
  <fieldset disabled={!enabled}>
    <legend class="sr-only">{t.formTitle}</legend>
    <div class="form-field"><label for="name">{t.labels.name}<span>{t.required}</span></label><input type="text" id="name" name="name" autocomplete="name" required maxlength="200" /></div>
    <div class="form-field"><label for="company">{t.labels.company}<span>{t.optional}</span></label><input type="text" id="company" name="company" autocomplete="organization" maxlength="200" /></div>
    <div class="form-field"><label for="email">{t.labels.email}<span>{t.required}</span></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" /></div>
    <div class="form-field"><label for="message">{t.labels.message}<span>{t.required}</span></label><p id="message-hint" class="field-hint">{t.messageHint}</p><textarea id="message" name="message" rows="6" required aria-describedby="message-hint" maxlength="10000"></textarea></div>
    <div hidden><label for="website">この欄は空欄のままにしてください</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
    {enabled && <><div class="cf-turnstile" data-sitekey={siteKey} data-action="contact" data-size="flexible"></div><noscript><p>フォームの送信にはJavaScriptが必要です。メールでもお問い合わせいただけます。</p></noscript></>}
    <p class="field-hint">入力いただいた情報は、お問い合わせへの対応に利用します。送信処理にはCloudflareとResendを使用します。</p>
    {site.contactPrivacyUrl && <p><a href={site.contactPrivacyUrl}>{t.privacy}</a></p>}
    <button type="submit" class="button" disabled={!enabled}>{enabled ? t.submit : t.disabled}</button>
  </fieldset>
</form>
